---
import '../i18n.config';
import AppLayout from '../layouts/AppLayout.astro';
import SearchHero from '../components/SearchHero';
import ProviderCarousel from '../components/ProviderCarousel';
import ServicesSection from '../components/ServicesSection';
import AboutSection from '../components/AboutSection';
---

<AppLayout
  title="PATA & CÃO — Plataforma Pet"
  description="Encontre prestadores de serviços pet verificados e confiáveis: hospedagem, passeadores e adestradores."
>
  {/* Rendered to HTML at build time, so every section is in place before any JS runs.
      With client:only they were empty until hydration, and each one popping in shifted the page.
      ServicesSection and AboutSection are static and need no JS at all. */}
  <SearchHero client:load />
  <ProviderCarousel client:load />
  <ServicesSection />
  <AboutSection />
</AppLayout>
