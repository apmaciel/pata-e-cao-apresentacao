---
import '../i18n.config';
import AppLayout from '../layouts/AppLayout.astro';
import SearchHero from '../components/SearchHero';
import SearchProviders from '../components/SearchProviders';
---

<AppLayout
  title="Prestadores — PATA & CÃO"
  description="Encontre e filtre prestadores de serviços pet verificados perto de você."
>
  {/* The hero reads the URL query on mount, so it stays client-only. Reserve its height
      (~142px) so the results below do not jump when it appears. */}
  <div class="min-h-[8.9rem]">
    <SearchHero mode="inline" client:only="react" />
  </div>
  <SearchProviders client:only="react" />
</AppLayout>
